{
  "name": "signal-scout",
  "version": "0.2.0",
  "description": "Git-native evidence CI for competitive changes.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Jannik Agethen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derprofi1313/signal-scout.git"
  },
  "bugs": {
    "url": "https://github.com/derprofi1313/signal-scout/issues"
  },
  "homepage": "https://github.com/derprofi1313/signal-scout#readme",
  "keywords": [
    "change-detection",
    "cli",
    "competitive-intelligence",
    "evidence",
    "market-intelligence"
  ],
  "bin": {
    "signal-scout": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "signal-scout.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.6.0 <12"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:cli && pnpm build:action",
    "build:action": "node scripts/build-action.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "prepack": "pnpm build:cli",
    "cli": "tsx src/cli/main.ts",
    "start": "next start",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.62.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "prettier": {
    "trailingComma": "all",
    "semi": true,
    "singleQuote": false,
    "printWidth": 100
  }
}
