{
  "name": "signal-scout",
  "version": "0.1.0",
  "description": "Git-native evidence CI for competitive changes.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Jannik Agethen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derprofi1313/signal-scout.git"
  },
  "bugs": {
    "url": "https://github.com/derprofi1313/signal-scout/issues"
  },
  "homepage": "https://github.com/derprofi1313/signal-scout#readme",
  "keywords": [
    "change-detection",
    "cli",
    "competitive-intelligence",
    "evidence",
    "market-intelligence"
  ],
  "bin": {
    "signal-scout": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "signal-scout.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:cli",
    "build:cli": "tsup src/cli/index.ts --format esm --dts --clean --banner.js '#!/usr/bin/env node'",
    "cli": "tsx src/cli/index.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "prettier": {
    "trailingComma": "all",
    "semi": true,
    "singleQuote": false,
    "printWidth": 100
  }
}
